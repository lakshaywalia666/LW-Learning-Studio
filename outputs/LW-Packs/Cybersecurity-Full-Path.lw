            "tools": [
              "TOOL-NOTE"
            ],
            "projectId": "",
            "required": true
          }
        ],
        "recall": {
          "question": "Why is the SSID not a trustworthy identity?",
          "answer": "The same visible network name can be configured by unrelated infrastructure."
        }
