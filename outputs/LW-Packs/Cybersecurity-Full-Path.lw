        "tasks": [
          {
            "id": "learn",
            "title": "Original contribution and responsible validation",
            "kind": "Study",
            "minutes": 45,
            "instructions": "An expert-track contribution may be a new method, meaningful tool, defensible vulnerability finding or important independent replication. Compare prior work and validate against counterexamples. Coordinate sensitive results responsibly and keep public artifacts harmless and free of private data.\n\nDeeper-study checklist: Original methods, tools, findings, rigorous replication. Use the section references to investigate these terms and connect them to the practice evidence.\n\nThink about this: What supports a genuine contribution claim?",
            "checklist": [],
            "resources": [
              "R-NICE",
              "R-CSF",
              "R-ASVS",
              "R-IR"
            ],
            "tools": [
              "TOOL-NOTE"
            ],
            "projectId": "",
            "required": true
          },
          {
            "id": "practice",
            "title": "Practice: Original contribution and responsible validation",
            "kind": "Lab",
            "minutes": 180,
            "instructions": "Develop a narrow original or replication project with a literature review, threat model, test package and independent critique.\n\nEnvironment: Paper and synthetic-data lab. Use only the scope established in section 01.\n\nKeep a short evidence note: expected result, observed result, explanation and one limitation. A paper or synthetic-data version is acceptable where the exercise offers it.",
            "checklist": [],
            "resources": [
              "R-NICE",
              "R-CSF",
              "R-ASVS",
              "R-IR"
            ],
            "tools": [
              "TOOL-NOTE"
            ],
            "projectId": "",
            "required": true
          },
          {
            "id": "verify",
            "title": "Explain and verify: Original contribution and responsible validation",
            "kind": "Assessment",
            "minutes": 45,
            "instructions": "What supports a genuine contribution claim?\n\nAnswer without notes first. Then compare with the topic recall answer or the exercise rubric. Explain one limitation and repeat or defend the main check independently. If you need guidance, revisit the lesson before claiming an independent result.",
            "checklist": [],
            "resources": [
              "R-NICE",
              "R-CSF",
              "R-ASVS",
              "R-IR"
            ],
            "tools": [
              "TOOL-NOTE"
            ],
            "projectId": "",
            "required": true
          }
        ],
        "recall": {
          "question": "What supports a genuine contribution claim?",
          "answer": "A clear comparison to prior work and independently verifiable evidence of the claimed improvement or result."
        }
