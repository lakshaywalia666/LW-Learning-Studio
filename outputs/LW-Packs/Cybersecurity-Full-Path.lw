        "location": "Owned local environment or paper alternative; setup is chosen and controlled by you."
      },
      {
        "id": "LAB-MOBILE",
        "title": "Owned mobile emulator or training device",
        "purpose": "Test self-authored or explicitly designated training apps.",
        "isolation": "Dummy data and scoped local file/provider access only; avoid personal accounts.",
        "recovery": "Export intended test evidence, reset the test app or emulator through a documented procedure.",
        "location": "Owned local environment or paper alternative; setup is chosen and controlled by you."
      },
      {
        "id": "LAB-SIM",
        "title": "High-impact and specialist simulation lab",
        "purpose": "Study OT, RF, vehicles, healthcare, financial systems and AI-agent effects.",
        "isolation": "Fictional workflows, offline traces, software simulations and fake assets. No interaction with operational critical systems.",
        "recovery": "Stop on unexpected external contact or effects; reset simulated state and document what the simulation cannot prove.",
        "location": "Owned local environment or paper alternative; setup is chosen and controlled by you."
      }
