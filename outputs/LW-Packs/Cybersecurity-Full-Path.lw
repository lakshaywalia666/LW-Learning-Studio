    "labs": [
      {
        "id": "LAB-PAPER",
        "title": "Paper and synthetic-data lab",
        "purpose": "Understand and model any section without deploying services.",
        "isolation": "Fictional organizations, dummy identities and synthetic event records only.",
        "recovery": "Retain the source fixture and reset the analysis copy.",
        "location": "Owned local environment or paper alternative; setup is chosen and controlled by you."
      },
      {
        "id": "LAB-HOST",
        "title": "Disposable administration lab",
        "purpose": "Practice Linux, Windows, coding and local networking.",
        "isolation": "Owned disposable virtual machines on a private network; no personal secrets, production accounts or broad host integrations.",
        "recovery": "Take a clean snapshot, keep important data outside the lab and demonstrate a full reset.",
        "location": "Owned local environment or paper alternative; setup is chosen and controlled by you."
      },
      {
        "id": "LAB-WEB",
        "title": "Local web application lab",
        "purpose": "Practice designated web/API security exercises and remediation.",
        "isolation": "Self-authored apps or explicitly designated training instances; bind vulnerable services to the isolated local lab.",
        "recovery": "Record target versions, dummy accounts and a known-good rebuild procedure.",
        "location": "Owned local environment or paper alternative; setup is chosen and controlled by you."
      },
      {
        "id": "LAB-IDENTITY",
