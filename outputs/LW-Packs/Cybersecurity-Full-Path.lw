    "glossary": [
      {
        "term": "Asset",
        "definition": "Something valuable that a security decision protects, including data, service, people and operational capability."
      },
      {
        "term": "Threat",
        "definition": "An actor, event or circumstance capable of causing harm under stated conditions."
      },
      {
        "term": "Vulnerability",
        "definition": "A weakness that can contribute to a security failure under particular preconditions."
      },
      {
        "term": "Risk",
        "definition": "A context-dependent description of potential harm, likelihood, impact and uncertainty."
      },
      {
        "term": "Control",
        "definition": "A technical, procedural or organizational measure intended to change a risk or enforce a requirement."
      },
      {
        "term": "Trust boundary",
        "definition": "A point where authority, identity or assumptions change and require explicit checks."
      },
      {
        "term": "Least privilege",
        "definition": "Grant only the access needed for a defined task and duration."
      },
      {
        "term": "Authentication",
        "definition": "Establishing confidence in the identity of a subject under an assurance model."
      },
      {
        "term": "Authorization",
        "definition": "Deciding whether an identified subject may perform a specific action on a specific resource."
      },
      {
        "term": "Accountability",
        "definition": "The ability to assign and review responsibility for decisions and actions."
      },
      {
        "term": "Confidentiality",
        "definition": "Restricting information disclosure to authorized parties under the threat model."
      },
      {
        "term": "Integrity",
        "definition": "Preserving authorized state and detecting or preventing unauthorized change."
      },
      {
        "term": "Availability",
        "definition": "Keeping required information and services usable under defined operating conditions."
      },
      {
        "term": "Privacy",
        "definition": "Managing risks to people from data processing, including collection, use, retention and sharing."
      },
      {
        "term": "Defense in depth",
        "definition": "Using complementary controls against different parts of a failure path."
      },
      {
        "term": "Attack surface",
        "definition": "The interfaces and conditions through which a system can be interacted with or influenced."
      },
      {
        "term": "Attack path",
        "definition": "A sequence of permissions, exposures and preconditions that can reach an objective."
      },
      {
        "term": "Adversary model",
        "definition": "The capabilities, knowledge and access assumed for a potential attacker."
      },
      {
        "term": "Rules of engagement",
        "definition": "An agreement defining authorized targets, methods, limits, contacts and stop conditions for a test."
      },
      {
        "term": "Baseline",
        "definition": "A documented reference state used to understand changes and anomalies."
      },
      {
        "term": "False positive",
        "definition": "An observation classified as a relevant threat when the investigated condition is benign."
      },
      {
        "term": "False negative",
        "definition": "A relevant condition that the detection or assessment fails to identify."
      },
      {
        "term": "IOC",
        "definition": "An indicator associated with possible malicious activity, meaningful only with provenance and context."
      },
      {
        "term": "TTP",
        "definition": "Tactics, techniques and procedures describing objectives, behaviors and implementation details."
      },
      {
        "term": "Telemetry",
        "definition": "Observed technical data collected to answer operational or investigative questions."
      },
      {
        "term": "SIEM",
        "definition": "A system for collecting, querying and interpreting security-relevant event data."
      },
      {
        "term": "EDR",
        "definition": "Endpoint detection and response capabilities; coverage and authority vary by implementation."
      },
      {
        "term": "NDR",
        "definition": "Network detection and response capabilities based on available network observations."
      },
      {
        "term": "Detection engineering",
        "definition": "Designing, validating, operating and maintaining analytics for relevant security behaviors."
      },
      {
        "term": "Threat hunting",
        "definition": "Hypothesis-driven investigation for behavior not adequately resolved by routine monitoring."
      },
      {
        "term": "Incident",
        "definition": "An event or series of events meeting an organization's definition of a security situation requiring response."
      },
      {
        "term": "Containment",
        "definition": "Actions intended to limit continuing harm or exposure during response."
      },
      {
        "term": "Eradication",
        "definition": "Removing an incident's cause, affected trust or unwanted capability as appropriate to the case."
      },
      {
        "term": "Recovery",
        "definition": "Restoring validated service, integrity and access after disruption or compromise."
      },
      {
        "term": "Chain of custody",
        "definition": "A record of evidence acquisition, handling, access and transfer."
      },
      {
        "term": "Hash",
        "definition": "A fixed-length digest computed from data using a stated algorithm; its guarantees depend on that algorithm and use."
      },
      {
        "term": "MAC",
        "definition": "A message authentication code computed using a shared secret to authenticate data under defined assumptions."
      },
      {
        "term": "Digital signature",
        "definition": "A cryptographic relationship between content, a signing private key and a corresponding verification public key."
      },
      {
        "term": "Nonce",
        "definition": "A value with uniqueness or freshness requirements in a particular protocol; it is not necessarily secret."
      },
      {
        "term": "Salt",
        "definition": "A public per-record value used in password hashing to prevent identical passwords sharing identical stored results."
      },
      {
        "term": "PKI",
        "definition": "Public-key infrastructure for binding keys to identities and operating issuance, trust and lifecycle processes."
      },
      {
        "term": "TLS",
        "definition": "A protocol family for protected transport with peer authentication according to its validation and configuration."
      },
      {
        "term": "MFA",
        "definition": "Authentication using factors from more than one category, with effectiveness depending on the implementation and recovery path."
      },
      {
        "term": "Passkey",
        "definition": "A public-key credential used for authentication, with platform and service-specific storage and recovery behavior."
      },
      {
        "term": "OAuth",
        "definition": "A framework for delegated access; it is not by itself a complete identity protocol."
      },
      {
        "term": "OpenID Connect",
        "definition": "An identity layer built on OAuth with defined authentication and token-validation semantics."
      },
      {
        "term": "RBAC",
        "definition": "Role-based access control, assigning permissions through defined roles."
      },
      {
        "term": "ABAC",
        "definition": "Attribute-based access control, evaluating policy using relevant subject, resource, action and environment attributes."
      },
      {
        "term": "Zero trust",
        "definition": "An architecture approach emphasizing explicit resource-access decisions rather than broad trust from network location."
      },
      {
        "term": "IDOR",
        "definition": "Insecure direct object reference, commonly describing missing object-level authorization around a supplied identifier."
      },
      {
        "term": "XSS",
        "definition": "Cross-site scripting, where untrusted content executes as browser code or markup in an unintended context."
      },
      {
        "term": "CSRF",
        "definition": "Cross-site request forgery, inducing a credentialed browser to perform an unwanted action."
      },
      {
        "term": "SSRF",
        "definition": "Server-side request forgery, influencing a server to make an unintended outbound request."
      },
      {
        "term": "CORS",
        "definition": "Browser-enforced cross-origin response-sharing policy; not a general server authorization or CSRF defense."
      },
      {
        "term": "CSP",
        "definition": "Content Security Policy, a browser policy mechanism that can add defense in depth against selected content-execution risks."
      },
      {
        "term": "Injection",
        "definition": "Untrusted data altering the meaning of instructions passed to an interpreter."
      },
      {
        "term": "Race condition",
        "definition": "An interleaving of operations that breaks an intended state or security invariant."
      },
      {
        "term": "Idempotency",
        "definition": "A property allowing a repeated operation to have the intended effect without unintended duplicate action."
      },
      {
        "term": "Invariant",
        "definition": "A property that should remain true across allowed state transitions."
      },
      {
        "term": "SBOM",
        "definition": "Software bill of materials, an inventory of components rather than a security guarantee."
      },
      {
        "term": "Provenance",
        "definition": "Information about an artifact's origin, inputs or production process, evaluated against an explicit trust policy."
      },
      {
        "term": "CVSS",
        "definition": "A vulnerability-severity scoring framework; not a complete organizational risk decision."
      },
      {
        "term": "EPSS",
        "definition": "A model for estimating exploitation probability under its stated data and time horizon."
      },
      {
        "term": "KEV",
        "definition": "CISA's Known Exploited Vulnerabilities catalogue, one source of exploitation evidence."
      },
      {
        "term": "RTO",
        "definition": "Recovery time objective: the business-defined target time for restoring a capability."
      },
      {
        "term": "RPO",
        "definition": "Recovery point objective: the business-defined tolerance for data loss, expressed in time."
      },
      {
        "term": "OT",
        "definition": "Operational technology that monitors or affects physical processes."
      },
      {
        "term": "ICS",
        "definition": "Industrial control systems, a subset of operational technology with control and supervisory components."
      },
      {
        "term": "HMI",
        "definition": "Human-machine interface used to observe or interact with a process or system."
      },
      {
        "term": "Secure boot",
        "definition": "Verification that startup components satisfy a configured authorization chain; not proof of bug-free code."
      },
      {
        "term": "Fuzzing",
        "definition": "Automated variation of inputs to explore behavior and identify failures within a defined harness and resource boundary."
      },
      {
        "term": "Sanitizer",
        "definition": "Instrumentation that detects selected classes of runtime errors during program execution."
      },
      {
        "term": "Rootkit",
        "definition": "A capability intended to conceal or maintain privileged presence; classify observed behavior and evidence rather than relying only on a label."
      },
      {
        "term": "Ransomware",
        "definition": "Malicious activity that restricts access, commonly through encryption, often combined with extortion or data theft."
      },
      {
        "term": "Command and control",
        "definition": "A communication mechanism through which an operator may direct compromised software or systems."
      },
      {
        "term": "Side channel",
        "definition": "Information leaked through an observable implementation effect outside an intended data interface."
      },
      {
        "term": "Prompt injection",
        "definition": "An attempt to redirect an AI-enabled system using instructions embedded in untrusted content."
      },
      {
        "term": "RAG",
        "definition": "Retrieval-augmented generation, supplying selected external content as context to a model."
      },
      {
        "term": "Model poisoning",
        "definition": "Malicious influence on training inputs or processes intended to change model behavior."
      },
      {
        "term": "Adversarial example",
        "definition": "An input designed to cause an undesired model outcome under a stated attack model."
      },
      {
        "term": "Post-quantum cryptography",
        "definition": "Cryptographic designs intended to resist relevant attacks from quantum computers under current assumptions."
      },
      {
        "term": "Coordinated disclosure",
        "definition": "Handling a vulnerability with affected parties through an agreed process to enable remediation and appropriate publication."
      }
    ],
    "guide": [
      {
        "title": "Start here",
        "body": "Begin with section 01, even if you intend to specialize later. Each lesson has three small tasks: learn the idea, perform one bounded practice exercise, and explain or verify the result. Each section ends with one project topic. In Study, open the current task to read What to learn, then tap Done after doing the work. There is no required long checkbox list. Logging actual study minutes is separate."
      },
      {
        "title": "How to judge completion",
        "body": "Done records your own progress. For a practical task, retain a sanitized note containing scope, environment, expected result, actual result, reasoning and limitations. Repeat a difficult task without instructions before claiming independence. A failed experiment can still produce useful learning; do not invent successful evidence. Exercises are self-assessed rather than accredited examinations."
      },
      {
        "title": "What is inside this file",
        "body": "This beginner-to-research roadmap contains 100 sections, 500 concise lesson topics, 100 section-project topics, 1600 individual Study tasks, 500 recall prompts and 600 self-assessment exercises. Each lesson includes a deeper-study keyword checklist, original explanation, practical prompt and answer. The final phase requires independent investigation, tool building, replication or original research, qualified peer challenge and an evidence portfolio. Linked documentation and sustained practice provide the depth beyond each concise explanation."
      },
      {
        "title": "Authorized practice environments",
        "body": "Use owned disposable machines, purpose-built training instances, dummy accounts, synthetic logs and fake data. Record exact authorization and stop conditions before active work. Harmful or high-impact behaviors are studied through behavior analysis, safe substitutes and tabletop simulations. The breadth includes offensive concepts, credential abuse, exploit principles, malware, rootkits, ransomware, wireless, critical systems and AI; practical method changes with consequence and authorization."
      },
      {
        "title": "Phone study and computer practice",
        "body": "All included explanations, recall prompts, project instructions and glossary text can be read offline after import. Opening publisher references or hosted labs needs an internet connection. Most technical labs need a computer, isolated virtual machines or other owned test equipment; the phone app records and guides the learning. Cloud accounts, specialist hardware and paid products are optional; paper and synthetic alternatives appear throughout. Do not create paid resources merely to advance a task."
      },
      {
        "title": "Time and pacing",
        "body": "Task minutes are planning estimates rather than guaranteed completion times. A beginner may need substantially more time for setup, programming and repeated practice. Work in order through the foundations, then revisit prerequisites when stuck. Treat this as a multi-year development programme if you are studying part time, and deepen one or two specialties after gaining broad literacy. Use a sustainable daily goal rather than rushing Done. The planned task total for this edition is about 2325 hours, excluding extra reading, failed attempts, infrastructure setup and specialist supervision. Treat that number as a scheduling aid."
      },
      {
        "title": "A simple evidence rubric",
        "body": "Use 0 when you cannot explain the idea, 1 for a guided attempt, 2 for an independent repeatable result, and 3 when you can explain tradeoffs, verify a fix and teach the result. A project needs a clear question, authorized scope, repeatable method, expected versus actual evidence, a justified conclusion and a retest or improvement. Seek qualified peer review for specialist work."
      },
      {
        "title": "References and changing information",
        "body": "The explanations are original course text; linked third-party documents and tools remain their publishers' work and are not bundled. Primary reference checks took place on 5–6 November 2026; individual records include check dates and note blocked or interactive sources. Frameworks, software, cloud behavior and laws change. Use the source edition matching your exercise and verify current official guidance before real-world decisions. Version labels are baselines, not a claim that no newer document can appear."
      },
      {
        "title": "Updates and your progress",
        "body": "Course ID and topic/task IDs are stable for this edition. Future revisions should preserve existing IDs rather than regenerating them. Review the app's import/update comparison before replacing an installed course. This .lw file contains curriculum only: no private notes, progress, credentials or completed tasks. Export a full workspace backup separately to protect your learning records."
      },
      {
        "title": "Mastery and specialization",
        "body": "No finite file contains every current and future cybersecurity topic, and no course can guarantee expertise. Mastery is shown by solving unfamiliar problems with sound methods, authorized practice, evidence, remediation and honest limits. Use the final sections to choose a specialty, maintain a research log, obtain feedback and repeatedly update your skills."
      },
      {
        "title": "Finding a topic",
        "body": "Use Search in LW for a topic name, concept or tool. Path and Topics show section order and prerequisites. Projects contain the section deliverables. Resources opens official reading. Exercises contains the lesson self-checks and project rubrics. Star difficult topics for later review rather than marking understanding you cannot demonstrate."
      },
      {
        "title": "Evidence gates for the expert track",
        "body": "After sections 01–18: Explain systems, networking, identity and risk; administer disposable hosts and defend a scoped assessment method without relying on memorized commands.\n\nAfter sections 19–50: Build and assess a small system, verify fixes, produce useful telemetry, investigate a synthetic incident and demonstrate recovery. Preserve limitations and failed hypotheses.\n\nAfter sections 51–82: Choose at least two specialties for independent depth. Reproduce published research, diagnose unfamiliar failures and verify root-cause improvements on exact platform versions.\n\nAfter sections 83–97: Design a falsifiable specialist study, evaluate realistic counterexamples, build or improve a research tool and obtain informed independent review.\n\nAfter sections 98–100: Defend a blind case, a multi-domain integration project and a meaningful original contribution or rigorous replication before qualified reviewers. Revise the work in response to criticism.\n\nDone is a personal progress marker. These gates require actual evidence; marking every task does not independently award a professional level or certification."
      },
      {
        "title": "Using the deeper-study checklists",
        "body": "Each lesson lists concrete terms to investigate, compare and connect to its practical work. They are a coverage index rather than separate full-length lectures. Read the official references, keep a concept note and extend the practice when a term remains unfamiliar. Advanced behavior names identify research and analysis subjects; they do not change the scope or authorization of your lab."
      }
    ],
    "exercises": [
      {
        "id": "EX-CS01-L01",
        "topicId": "CS01-L01",
        "type": "scenario",
        "title": "Self-check: Permission, scope and rules of engagement",
        "prompt": "What makes a test authorized? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: An authorized owner agrees to the specific target, methods and time; the tester stays inside that agreement. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS01-L02",
        "topicId": "CS01-L02",
        "type": "scenario",
        "title": "Self-check: Assets, threats, vulnerabilities and risk",
        "prompt": "Why is a vulnerability score not the whole risk? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: Exposure, business impact, existing controls and exploitation evidence change the decision. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS01-L03",
        "topicId": "CS01-L03",
        "type": "scenario",
        "title": "Self-check: Confidentiality, integrity and availability",
        "prompt": "Can one control guarantee all three goals? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: No; controls address different failure modes and need testing together. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS01-L04",
        "topicId": "CS01-L04",
        "type": "scenario",
        "title": "Self-check: Evidence and deliberate practice",
        "prompt": "What separates evidence from a conclusion? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: Evidence is the reproducible observation; a conclusion explains it and states uncertainty. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS01-L05",
        "topicId": "CS01-L05",
        "type": "scenario",
        "title": "Self-check: Personal security and recovery habits",
        "prompt": "Why test recovery before an incident? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: An untested backup or account-recovery path may fail when it is needed most. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS01-PROJECT",
        "topicId": "CS01-PROJECT",
        "type": "rubric",
        "title": "Project review: Start safely and think like a security professional",
        "prompt": "Create a personal lab charter, an asset list and a repeatable evidence notebook. Show one successful backup and recovery.",
        "rubric": "Deliver a sanitized project record with the objective, authorized scope, environment and versions, repeatable method, expected versus actual evidence, justified conclusions, limitations and a successful retest or improvement. For a paper design, show how each control would be verified and which claims remain untested. Score 0 for incomplete; 1 for guided work; 2 for independent reproducible work; 3 for independent work with a verified improvement, sound limits and peer review where available."
      },
      {
        "id": "EX-CS02-L01",
        "topicId": "CS02-L01",
        "type": "scenario",
        "title": "Self-check: CPU, memory and storage",
        "prompt": "Why does high CPU use not prove compromise? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: Many legitimate tasks use CPU; attribution needs process context and corroborating evidence. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS02-L02",
        "topicId": "CS02-L02",
        "type": "scenario",
        "title": "Self-check: Processes, threads and privilege",
        "prompt": "How does a process differ from a thread? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: A process is a resource and isolation boundary; threads are execution paths within it. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS02-L03",
        "topicId": "CS02-L03",
        "type": "scenario",
        "title": "Self-check: Files, paths and permissions",
        "prompt": "Why is an extension insufficient to trust a file? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: Names can be changed; actual format, origin and behavior require separate checks. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS02-L04",
        "topicId": "CS02-L04",
        "type": "scenario",
        "title": "Self-check: Binary, hexadecimal and encodings",
        "prompt": "Is Base64 encryption? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: No; it is a public encoding with no secret key. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS02-L05",
        "topicId": "CS02-L05",
        "type": "scenario",
        "title": "Self-check: Virtualization and trust boundaries",
        "prompt": "Why is a container not the same boundary as a VM? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: Containers normally share a kernel, so host-kernel compromise and privileged integrations change isolation. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS02-PROJECT",
        "topicId": "CS02-PROJECT",
        "type": "rubric",
        "title": "Project review: Computers, operating systems and data",
        "prompt": "Build a diagram showing a request moving through CPU, memory, storage, processes and user permissions on a test machine.",
        "rubric": "Deliver a sanitized project record with the objective, authorized scope, environment and versions, repeatable method, expected versus actual evidence, justified conclusions, limitations and a successful retest or improvement. For a paper design, show how each control would be verified and which claims remain untested. Score 0 for incomplete; 1 for guided work; 2 for independent reproducible work; 3 for independent work with a verified improvement, sound limits and peer review where available."
      },
      {
        "id": "EX-CS03-L01",
        "topicId": "CS03-L01",
        "type": "scenario",
        "title": "Self-check: Layers, frames and packets",
        "prompt": "Why troubleshoot by layer? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: Each layer has different evidence and failure modes, narrowing the cause systematically. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS03-L02",
        "topicId": "CS03-L02",
        "type": "scenario",
        "title": "Self-check: IPv4, IPv6 and subnetting",
        "prompt": "Does a private address make a host secure? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: No; reachable peers, routing, services and access controls still determine exposure. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS03-L03",
        "topicId": "CS03-L03",
        "type": "scenario",
        "title": "Self-check: TCP, UDP and connection state",
        "prompt": "Why can UDP still support a reliable application? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: Reliability can be implemented above UDP by the application protocol. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS03-L04",
        "topicId": "CS03-L04",
        "type": "scenario",
        "title": "Self-check: Routing, switching, NAT and segmentation",
        "prompt": "Is NAT a replacement for a firewall policy? Support your answer with one concrete example from your practice.",
        "rubric": "Core idea: No; translation does not express or verify the complete access policy. Self-assess honestly: 0 = need help; 1 = guided attempt; 2 = independent result; 3 = can explain, repeat and discuss a limitation."
      },
      {
        "id": "EX-CS03-L05",
        "topicId": "CS03-L05",
