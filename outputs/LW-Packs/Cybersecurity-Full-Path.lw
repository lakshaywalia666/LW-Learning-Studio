    "tools": [
      {
        "id": "TOOL-NOTE",
        "title": "Evidence notebook",
        "domain": "Cybersecurity learning and research",
        "resource": "R-NICE",
        "task": "Record scope, hypotheses, actions, observations, uncertainty and retest results.",
        "evidenceRequired": "A reproducible, sanitized evidence note.",
        "limits": "No real secrets, unrelated personal data or client material in course evidence."
      },
      {
        "id": "TOOL-LINUX",
        "title": "Linux learning VM",
        "domain": "Cybersecurity learning and research",
        "resource": "R-LINUX",
        "task": "Inspect permissions, processes, logs and a reversible local hardening change.",
        "evidenceRequired": "Before/after baseline and a successful reset.",
        "limits": "Disposable VM or paper alternative; no host-wide destructive commands."
      },
      {
        "id": "TOOL-WINDOWS",
        "title": "Windows learning VM and PowerShell",
        "domain": "Cybersecurity learning and research",
        "resource": "R-WINDOWS",
        "task": "Create read-only inventory and inspect synthetic administrative events.",
        "evidenceRequired": "Structured inventory and documented event context.",
        "limits": "Use dummy local accounts and platform documentation matching the installed version."
      },
      {
        "id": "TOOL-PYTHON",
        "title": "Python local automation",
        "domain": "Cybersecurity learning and research",
        "resource": "R-PYTHON",
        "task": "Parse synthetic event files with validation and bounded error handling.",
        "evidenceRequired": "Tests, fixture data and repeatable output.",
        "limits": "No credential harvesting, unsolicited requests or automation against unrelated systems."
      },
      {
        "id": "TOOL-GIT",
        "title": "Git version control",
        "domain": "Cybersecurity learning and research",
        "resource": "R-GIT",
        "task": "Version an exercise, review a change and retain regression tests.",
        "evidenceRequired": "Local history, review rationale and build instructions.",
        "limits": "Keep secrets out of source history. A leak needs invalidation, not just deletion."
      },
      {
        "id": "TOOL-WIRESHARK",
        "title": "Wireshark",
        "domain": "Cybersecurity learning and research",
        "resource": "R-WIRESHARK",
        "task": "Annotate a capture from your own isolated lab traffic.",
        "evidenceRequired": "Capture provenance, filter explanation and visibility limits.",
        "limits": "Only authorized traffic; sanitize shared evidence and retain original artifacts privately."
      },
      {
        "id": "TOOL-BROWSER",
        "title": "Browser developer tools",
        "domain": "Cybersecurity learning and research",
        "resource": "R-MDN",
        "task": "Inspect dummy requests, responses and browser storage on a local demo.",
        "evidenceRequired": "Annotated request and origin/storage model.",
        "limits": "No real sessions or other users' information in screenshots or exported traces."
      },
      {
        "id": "TOOL-WEBLAB",
        "title": "Designated web training lab",
        "domain": "Cybersecurity learning and research",
        "resource": "R-PORT",
        "task": "Complete platform-designated exercises and explain cause, fix and regression case.",
        "evidenceRequired": "A sanitized training write-up, with target authorization.",
        "limits": "Authorization is limited to designated lab instances and the platform's rules."
      },
      {
        "id": "TOOL-THREAT",
        "title": "Threat-model diagram",
        "domain": "Cybersecurity learning and research",
        "resource": "R-DRAGON",
        "task": "Draw data flows and trust boundaries and map concrete abuse cases.",
        "evidenceRequired": "Diagram, assumptions and prioritized controls.",
        "limits": "Paper is sufficient; installing a particular tool is optional."
      },
      {
        "id": "TOOL-CONTAINER",
        "title": "Local container runtime",
        "domain": "Cybersecurity learning and research",
        "resource": "R-DOCKER",
        "task": "Run a self-authored local service with constrained privilege and mounts.",
        "evidenceRequired": "Image identity, runtime settings and a boundary analysis.",
        "limits": "Do not expose intentionally vulnerable training services publicly."
      },
      {
        "id": "TOOL-KUBE",
        "title": "Local Kubernetes or manifest review",
        "domain": "Cybersecurity learning and research",
        "resource": "R-KUBE",
        "task": "Review RBAC, workloads, secrets and network-policy assumptions.",
        "evidenceRequired": "Manifest review, negative tests or a paper enforcement plan.",
        "limits": "A local isolated cluster or paper design is enough; cloud deployment is not required."
      },
      {
        "id": "TOOL-SIGMA",
