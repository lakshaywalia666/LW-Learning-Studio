<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/personal_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
 <TextView android:id="@+id/personal_widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Personal reminders" android:textColor="#B8E6AD" android:textSize="16sp" android:paddingBottom="8dp"/>
 <LinearLayout android:id="@+id/personal_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"><TextView android:id="@+id/personal_title_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#F1F6F1" android:textSize="14sp"/><Button android:id="@+id/personal_done_1" android:layout_width="64dp" android:layout_height="48dp" android:text="Done" android:textSize="11sp"/><Button android:id="@+id/personal_later_1" android:layout_width="72dp" android:layout_height="48dp" android:text="+1 day" android:textSize="11sp"/></LinearLayout>
 <LinearLayout android:id="@+id/personal_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"><TextView android:id="@+id/personal_title_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#F1F6F1" android:textSize="14sp"/><Button android:id="@+id/personal_done_2" android:layout_width="64dp" android:layout_height="48dp" android:text="Done" android:textSize="11sp"/><Button android:id="@+id/personal_later_2" android:layout_width="72dp" android:layout_height="48dp" android:text="+1 day" android:textSize="11sp"/></LinearLayout>
 <LinearLayout android:id="@+id/personal_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"><TextView android:id="@+id/personal_title_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:textColor="#F1F6F1" android:textSize="14sp"/><Button android:id="@+id/personal_done_3" android:layout_width="64dp" android:layout_height="48dp" android:text="Done" android:textSize="11sp"/><Button android:id="@+id/personal_later_3" android:layout_width="72dp" android:layout_height="48dp" android:text="+1 day" android:textSize="11sp"/></LinearLayout>
 <TextView android:id="@+id/personal_widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textColor="#D5E9DC" android:textSize="14sp"/>
 <Button android:id="@+id/personal_widget_undo" android:layout_width="match_parent" android:layout_height="48dp" android:text="Undo last reminder action" android:textSize="12sp"/>
</LinearLayout>
