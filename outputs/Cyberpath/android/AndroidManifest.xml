   <intent-filter><action android:name="android.intent.action.SEND"/><category android:name="android.intent.category.DEFAULT"/><data android:mimeType="text/plain"/><data android:mimeType="text/markdown"/><data android:mimeType="image/png"/><data android:mimeType="image/jpeg"/><data android:mimeType="image/webp"/><data android:mimeType="image/gif"/><data android:mimeType="application/pdf"/><data android:mimeType="audio/*"/><data android:mimeType="application/vnd.lw.course+json"/><data android:mimeType="application/octet-stream"/><data android:mimeType="application/json"/></intent-filter>
