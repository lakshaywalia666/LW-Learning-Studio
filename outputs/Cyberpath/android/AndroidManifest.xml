 <queries><intent><action android:name="android.intent.action.TTS_SERVICE"/></intent></queries>
 <application android:label="LW Learning Studio" android:icon="@mipmap/ic_launcher" android:theme="@style/AppTheme" android:hardwareAccelerated="true" android:allowBackup="false" android:debuggable="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
